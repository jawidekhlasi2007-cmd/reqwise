{
  "name": "reqwise",
  "version": "1.0.0",
  "private": true,
  "description": "ReqWise: checks software requirements documents for unclear, missing and conflicting requirements (ISO/IEC/IEEE 29148, IEEE 830), powered by Google Gemini.",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "agent": "tsx scripts/run-agent.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": ">=0.460.0 <1.0.0",
    "mammoth": "^1.8.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0",
    "unpdf": ">=0.12.0 <2.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
