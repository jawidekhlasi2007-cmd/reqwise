# Copy this file to .env.local and fill in your key.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. The model the agents call first.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Tried in order when the primary model is not available to your key
# (Google limits gemini-2.5-flash to projects that used it before).
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
